build/
.vscode/

# external/eigen/Eigen is vendored in git (header-only, MPL2) so `pip install .`
# and R's configure work from a fresh clone without a manual download step.
# pybind11 is not vendored - it comes from the pybind11 PyPI package at build time.
external/*
!external/eigen/
external/eigen/*
!external/eigen/Eigen/
!external/eigen/COPYING*
!external/eigen/LICENSE

.Rproj.user

# R build artifacts (regenerated by configure + R CMD INSTALL)
*.o
*.so
*.dll
.Rhistory
.RData

__pycache__/
*.pyc
*.egg-info/
.venv/

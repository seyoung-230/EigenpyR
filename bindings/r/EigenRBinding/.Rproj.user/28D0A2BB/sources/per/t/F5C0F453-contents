set.seed(123)
n = 100
p = 10
X = matrix(rnorm(n * p), n, p)
beta_true = c(2, -1, rep(0, p - 2))
y = drop(1 + X %*% beta_true + 0.1 * rnorm(n))

# construct and fit
lm_lasso = new(LmLasso, 0.03)
lm_lasso$fit(X, y, 1000, 1e-6)

print(lm_lasso$intercept())
print(lm_lasso$coef())

# prediction
X_new = X[1:5, ]
pred = lm_lasso$predict(X_new)
print(pred)


n = 100
p = 10
X = matrix(rnorm(n * p), n, p)
beta_true = c(2, -1, rep(0, p - 2))
y = drop(X %*% beta_true + rnorm(n))
# construct and fit
lm_lasso = new(LmLasso, 0.03)
lm_lasso$fit(X, y, 1000, 1e-6)
print(lm_lasso$intercept())
print(lm_lasso$coef())
